DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Local default is SQLite. For MySQL:  mysql://user:password@127.0.0.1:3306/librasphere
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Africa/Nairobi
# "basic" works everywhere; "mysql_fulltext" after running: python manage.py create_fulltext_index
SEARCH_BACKEND=basic
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_EAGER=1
FINE_BLOCK_THRESHOLD=500
